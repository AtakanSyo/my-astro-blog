---
import logoUrl from '../assets/images/shared/logo.svg?url';
import { Search, X } from 'lucide-react';

const labels = {
  home: 'Home',
  searchPlaceholder: 'Search…',
  searchAria: 'Search posts',
  menuToggleAria: 'Toggle menu',
  searchToggleAria: 'Open search',
  searchCloseAria: 'Close search',
};

const siteName = Astro.site?.hostname ?? 'Astrosyo';
---

<header>
  <div class="header-inner">
    <a href="/" class="logo centered_flex" aria-label={labels.home}>
      <img src={logoUrl} alt={siteName} />
    </a>

    <button
      class="nav-toggle"
      type="button"
      aria-label={labels.menuToggleAria}
      aria-controls="site-nav"
      aria-expanded="false"
    >
      <span class="hamburger"></span>
    </button>

    <nav class="site-nav" id="site-nav">
      <button class="nav-search-toggle" aria-label={labels.searchToggleAria} type="button">
        <Search size={18} strokeWidth={1.75} aria-hidden="true" />
      </button>

      <form action="/search" method="get" class="nav-search-form">
        <Search size={16} strokeWidth={1.75} className="nav-search-icon" aria-hidden="true" />
        <input
          type="search"
          name="q"
          class="nav-search-input"
          placeholder={labels.searchPlaceholder}
          aria-label={labels.searchAria}
        />
        <button type="button" class="nav-search-close" aria-label={labels.searchCloseAria}>
          <X size={14} strokeWidth={2} aria-hidden="true" />
        </button>
      </form>
    </nav>
  </div>
</header>
