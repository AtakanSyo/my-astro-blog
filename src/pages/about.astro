---
import Layout from '../layouts/Layout.astro';

import '../styles/index.css';
import '../styles/cards.css';
import '../styles/about.css';
---


<Layout title="About Astrosyo">
  <main class="about-page page-home">
    <section class="hero about-hero">
      <h1 class="home-title">About Astrosyo</h1>
      <p class="home-description">
        Astrosyo is a compact astronomy site focused on visual learning and
        science storytelling.
      </p>
    </section>

    <section class="about-grid about-grid--notices">
      <article class="about-card">
        <h2>What We Have Right Now</h2>
        <p>
          The site currently includes cosmic stories, informational astronomy
          posts, and interactive simulations. You can browse recent posts, open
          category pages, and use search to find specific topics quickly.
        </p>
      </article>

      <article class="about-card">
        <h2>Main Focus</h2>
        <p>
          The focus is clear explanations, visual intuition, and lightweight
          interactive experiences that make space topics easier to understand.
        </p>
      </article>

      <article class="about-card">
        <h2>Current Direction</h2>
        <p>
          Astrosyo is currently centered on educational content and simulation-led
          storytelling across astronomy topics.
        </p>
      </article>
    </section>
  </main>
</Layout>
